# Copy this file to .env before running TREK.
# Never commit the real .env file.

# Public URL where TREK will be available.
# Example: https://trip.example.com
APP_URL=https://trip.example.com

# Generate a unique 64-character hex key for production:
# openssl rand -hex 32
ENCRYPTION_KEY=change-me-generate-a-long-random-hex-key

# Optional: set your server timezone.
TZ=Asia/Shanghai

# Optional: tune app log level.
LOG_LEVEL=info
